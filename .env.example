# Скопируйте в .env: install -m 600 .env.example .env. Поправьте под себя.
# Docker Compose читает .env автоматически; make run тоже читает этот файл.
# JWT_SECRET, REDIS_PASSWORD и пять паролей PostgreSQL обязательны для Compose.

# --- Общие для сервисов ---
# Уровень логов: debug | info | warn | error
LOG_LEVEL=info
# Формат логов: json | text
LOG_FORMAT=json
# Часовой пояс: от него зависит дата «сегодня» для транзакций без даты
TZ=Europe/Moscow

# --- Токены (нужны gateway и auth) ---
# Секрет подписи JWT: случайные байты, не меньше 32, без значения по умолчанию.
# Сгенерировать и дописать в .env:
#   echo "JWT_SECRET=$(openssl rand -base64 32)" >> .env
# JWT_SECRET=
# Срок жизни токена (не больше 720h)
JWT_TTL=24h

# --- Gateway (HTTP) ---
# Порт на хосте, на котором доступен HTTP API (compose)
HTTP_PORT=127.0.0.1:8080
# Адреса сервисов для запуска без Docker; в compose заданы в compose.yaml
LEDGER_GRPC_ADDR=localhost:9090
AUTH_GRPC_ADDR=localhost:9091
# Сколько gateway ждёт ответа сервиса, потом отвечает 504
LEDGER_TIMEOUT=10s
AUTH_TIMEOUT=10s
# Срок каждой фазы CSV-импорта по отдельности: чтения тела запроса и вызова Ledger.
# Это не общий предел запроса: между фазами идёт разбор файла, после них есть запас на ответ.
IMPORT_TIMEOUT=1m

# --- Ledger (gRPC) ---
# Порт gRPC на хосте, только с compose.dev.yaml, на 127.0.0.1
LEDGER_GRPC_PORT=9090
# Строка подключения без имени и пароля для make run и make migrate.
# Каждая команда получает свою роль через PGUSER и PGPASSWORD.
# Пустое значение включает хранилище в памяти у Auth и Ledger.
# DATABASE_URL=postgres://localhost:5432/finance?sslmode=disable
# Сколько ждать базу при старте
DB_CONNECT_WAIT=30s
# Redis для кеша отчётов при запуске без Docker (make db поднимает и его).
# В compose адрес задан в compose.yaml. При пустом значении отчёты работают без кеша.
# REDIS_URL=redis://localhost:6379/0
# Сколько живёт отчёт в кеше
REPORT_CACHE_TTL=5m
# Сколько строк CSV-импорта записываются одновременно, на все импорты вместе
# (не больше половины DB_MAX_CONNS)
IMPORT_WORKERS=4
# Размер пула соединений ledger с PostgreSQL
DB_MAX_CONNS=16

# --- Auth (gRPC) ---
# Разрешённые email через запятую, максимум 100. Пусто: регистрация закрыта.
# Это ограничение регистрации, а не подтверждение владения почтой.
AUTH_REGISTRATION_EMAILS=
# Порт gRPC на хосте, только с compose.dev.yaml, на 127.0.0.1
AUTH_GRPC_PORT=9091

# --- Redis (сервис redis в compose) ---
# Независимый случайный пароль, минимум 32 байта. Только для Redis и Ledger.
# REDIS_PASSWORD=
# Порт на хосте, только с compose.dev.yaml, на 127.0.0.1
REDIS_PORT=6379

# --- Публичный HTTPS через Caddy (compose.yaml + compose.https.yaml) ---
# Домен без https:// и пути. A-запись должна указывать на публичный IPv4 сервера.
# Нужны внешние TCP-порты 80 и 443; сертификат получает и продлевает Caddy.
# FINANCE_DOMAIN=api.example.com
# Порт Gateway на 127.0.0.1 в HTTPS-режиме; HTTP_PORT в этом режиме заменяется.
# HTTPS_GATEWAY_PORT=8080

# Для переноса готового linux/amd64-выпуска без сборки и доступа к GitHub.
# FINANCE_RELEASE_TAG берётся из release-manifest.json; том проверить на сервере.
# FINANCE_RELEASE_TAG=release-tag
# FINANCE_PGDATA_VOLUME=existing-project_pgdata

# --- PostgreSQL (сервис db в compose) ---
POSTGRES_USER=finance
# Сгенерируйте независимые пароли перед первым запуском:
# for name in REDIS_PASSWORD POSTGRES_PASSWORD AUTH_DB_PASSWORD LEDGER_DB_PASSWORD AUTH_MIGRATION_PASSWORD LEDGER_MIGRATION_PASSWORD; do
#   printf '%s=%s\n' "$name" "$(openssl rand -hex 32)" >> .env
# done
# POSTGRES_PASSWORD=
# AUTH_DB_PASSWORD=
# LEDGER_DB_PASSWORD=
# AUTH_MIGRATION_PASSWORD=
# LEDGER_MIGRATION_PASSWORD=
POSTGRES_DB=finance
# Порт на хосте, только с compose.dev.yaml, на 127.0.0.1
POSTGRES_PORT=5432
